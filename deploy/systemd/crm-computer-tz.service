[Unit]
Description=CRM computer TZ → supplier card (one batch)
After=network-online.target

[Service]
Type=oneshot
User=sergey
WorkingDirectory=/opt/CRM_Streamlit
EnvironmentFile=-/opt/CRM_Streamlit/.env
Environment=PYTHONPATH=/opt/CRM_Streamlit:/opt/pythonProject89:/opt/tender_documents_research
Environment=TENDER_DOCS_RESEARCH_ROOT=/opt/tender_documents_research
ExecStart=/opt/CRM_Streamlit/.venv/bin/python /opt/CRM_Streamlit/scripts/computer_tz_daemon.py --once --only-open --limit 30
Nice=10

[Install]
WantedBy=multi-user.target
