[Unit]
Description=Tender documents worker 2 (awarded registries)
Wants=network-online.target
After=network-online.target amneziawg-worker.service
RequiresMountsFor=/data

[Service]
Type=simple
User=<SSH_USER>
Group=<SSH_USER>
WorkingDirectory=/opt/tender_documents_research
EnvironmentFile=/opt/tender_documents_research/.env
EnvironmentFile=/etc/tender-docs-db.env
EnvironmentFile=/etc/tender-docs-worker-awarded-2.env
ExecStart=/opt/tender_documents_research/.venv/bin/python -m document_processor.daemon
Restart=on-failure
RestartSec=20
TimeoutStopSec=120
KillSignal=SIGTERM
Nice=10
MemoryMax=5G
CPUQuota=150%
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
