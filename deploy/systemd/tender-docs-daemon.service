[Unit]
Description=Tender documents research worker
Wants=network-online.target
After=network-online.target amneziawg-worker.service
RequiresMountsFor=/data

[Service]
Type=simple
User=<SSH_USER>
Group=<SSH_USER>
WorkingDirectory=/opt/tender_documents_research
EnvironmentFile=/opt/tender_documents_research/.env
EnvironmentFile=/etc/tender-docs-db.env
EnvironmentFile=/etc/tender-docs-worker.env
ExecStart=/opt/tender_documents_research/.venv/bin/python -m document_processor.daemon
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillSignal=SIGTERM
MemoryMax=28G
CPUQuota=700%
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
