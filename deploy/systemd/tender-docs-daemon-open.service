[Unit]
Description=Tender documents worker (open/new registries)
Wants=network-online.target
After=network-online.target amneziawg-worker.service
RequiresMountsFor=/data

[Service]
Type=simple
User=sergey
Group=sergey
WorkingDirectory=/opt/tender_documents_research
EnvironmentFile=/opt/tender_documents_research/.env
EnvironmentFile=/etc/tender-docs-db.env
EnvironmentFile=/etc/tender-docs-worker-open.env
ExecStart=/opt/tender_documents_research/.venv/bin/python -m document_processor.daemon
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillSignal=SIGTERM
MemoryMax=18G
CPUQuota=450%
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
