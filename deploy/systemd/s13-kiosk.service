[Unit]
Description=S13 graphical kiosk (X + Firefox fullscreen dashboard)
After=multi-user.target s13-web-dashboard.service
Wants=s13-web-dashboard.service
Conflicts=getty@tty7.service

[Service]
Type=simple
User=sergey
Environment=HOME=/home/sergey
Environment=XAUTHORITY=/home/sergey/.Xauthority
ExecStart=/usr/bin/xinit /usr/local/bin/s13_kiosk_start.sh -- :0 vt7 -nolisten tcp
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
