[Unit]
Description=CRM V3 Daily Dataset Builder Service
After=network.target postgresql.service

[Service]
Type=oneshot
User=sergey
WorkingDirectory=/opt/CRM_Streamlit
ExecStart=/opt/CRM_Streamlit/.venv313/bin/python /opt/CRM_Streamlit/src/services/commercial_routing_v3/dataset_builder.py
EnvironmentFile=/etc/crm_v3.env
Environment=PYTHONUNBUFFERED=1
