[Unit]
Description=CRM V3 Continuous Second Pass Worker (Qwen 2.5:7b)
After=network.target tender-docs-daemon-open.service

[Service]
Type=simple
User=sergey
Group=sergey
WorkingDirectory=/opt/CRM_Streamlit
EnvironmentFile=/opt/CRM_Streamlit/.env
Environment=PYTHONPATH=/opt/CRM_Streamlit:/opt/pythonProject89
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen2.5:7b
Environment=LOG_LEVEL=INFO
ExecStart=/opt/CRM_Streamlit/.venv313/bin/python /opt/CRM_Streamlit/scripts/run_second_pass_worker.py --interval 15 --batch-size 5
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
