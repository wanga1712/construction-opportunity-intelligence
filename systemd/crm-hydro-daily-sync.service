[Unit]
Description=CRM hydro parking leads daily sync (canonical CRM store)
After=network.target postgresql.service

[Service]
Type=oneshot
User=sergey
Group=sergey
WorkingDirectory=/opt/CRM_Streamlit
EnvironmentFile=/opt/CRM_Streamlit/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/CRM_Streamlit:/opt/pythonProject89
ExecStart=/opt/CRM_Streamlit/.venv313/bin/python /opt/CRM_Streamlit/scripts/hydro_daily_sync.py
