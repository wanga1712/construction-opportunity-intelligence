[Unit]
Description=ACTIVE_NEED_HTTP_AND_PROMOTION_V1 continuous production loop (A-bucket docs -> facts -> confirmed_base -> current_effective)
Documentation=docs/REFACTORING_PLAN.md
After=network-online.target postgresql@17-main.service
Wants=network-online.target

[Service]
Type=simple
User=sergey
Group=sergey
WorkingDirectory=/opt/tender_documents_research
# Same environment as the document workers: the shared EIS gate
# (DownloadCoordinator + HttpFileClient + download_throttle) stays in force.
EnvironmentFile=/opt/tender_documents_research/.env
EnvironmentFile=/etc/tender-docs-db.env
EnvironmentFile=/etc/tender-docs-worker-open.env
EnvironmentFile=-/etc/tender-docs-s13v2-overlay.env
EnvironmentFile=-/etc/tender-docs-s13-local-db.env
EnvironmentFile=/opt/CRM_Streamlit/.env
Environment=PROCESSING_BACKEND=S13_V2
Environment=DOCUMENT_STORAGE_ROOT=/data/tender-documents
Environment=DOCUMENT_DOWNLOAD_DIR=/data/tender-documents/downloads
Environment=S13_DOCUMENT_DB_HOST=127.0.0.1
Environment=S13_DOCUMENT_DB_PORT=5432
Environment=S13_DOCUMENT_DB_NAME=document_intelligence
# Cycle cadence (source sync runs every ~15 min).
Environment=ACTIVE_LOOP_SLEEP_SECONDS=900
# Batch size before promotion/recalculation; medals limit covers all CURRENT opportunities.
Environment=ACTIVE_LOOP_BATCH=100
Environment=ACTIVE_LOOP_MEDAL_LIMIT=50000

ExecStart=/opt/tender_documents_research/.venv/bin/python /opt/CRM_Streamlit/scripts/run_active_production_loop.py
Restart=always
RestartSec=30
Nice=10
IOSchedulingClass=idle

# Heartbeat: /tmp/active_production_loop.json (per-cycle), full log below.
StandardOutput=append:/tmp/active_production_loop.log
StandardError=append:/tmp/active_production_loop.log

[Install]
WantedBy=multi-user.target
