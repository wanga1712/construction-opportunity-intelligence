[Unit]
Description=CRM V3 Learning Observer Daemon
After=network.target postgresql.service

[Service]
Type=simple
User=sergey
WorkingDirectory=/opt/CRM_Streamlit_rescue
ExecStart=/opt/CRM_Streamlit/.venv313/bin/python /opt/CRM_Streamlit_rescue/src/services/commercial_routing_v3/learning_observer.py
Restart=always
RestartSec=5
EnvironmentFile=/etc/crm_v3.env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
