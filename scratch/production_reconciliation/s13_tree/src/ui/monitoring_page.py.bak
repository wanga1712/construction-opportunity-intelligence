"""Server monitoring dashboard — temperature, RAM, load, daemon status."""
from __future__ import annotations

from datetime import datetime, timedelta

import pandas as pd
import streamlit as st


_WORKERS = [
    ("tender-docs-daemon-open",     13, "open 44/223"),
    ("tender-docs-daemon-open-2",   15, "open 44/223"),
    ("tender-docs-daemon-open-3",   16, "open 44/223"),
    ("tender-docs-daemon-awarded",  14, "awarded 44/223"),
    ("tender-docs-daemon-awarded-2",17, "awarded 44/223"),
]

_CPU_WARN  = 60
_CPU_CRIT  = 75
_GPU_WARN  = 65
_GPU_CRIT  = 80


def _temp_color(t: int | None, warn: int, crit: int) -> str:
    if t is None:
        return "—"
    if t >= crit:
        return f"🔴 {t}°C"
    if t >= warn:
        return f"🟡 {t}°C"
    return f"🟢 {t}°C"


@st.cache_data(ttl=55)
def _load_metrics(tender_db, hours: int = 3) -> pd.DataFrame:
    rows = tender_db.execute_query(
        """
        SELECT recorded_at, cpu_temp, gpu_temp,
               ROUND(ram_used_mb * 100.0 / NULLIF(ram_total_mb,0), 1) AS ram_pct,
               load_1min, load_5min, cpu_pct
        FROM server_metrics
        WHERE server_id = 13
          AND recorded_at >= NOW() - INTERVAL '%s hours'
        ORDER BY recorded_at ASC
        """,
        (hours,),
    )
    if not rows:
        return pd.DataFrame()
    df = pd.DataFrame(rows)
    df["recorded_at"] = pd.to_datetime(df["recorded_at"])
    df = df.set_index("recorded_at")
    for col in ["cpu_temp", "gpu_temp", "ram_pct", "load_1min", "load_5min", "cpu_pct"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    return df


@st.cache_data(ttl=55)
def _load_queue(tender_db) -> list[dict]:
    return tender_db.execute_query(
        "SELECT status, COUNT(*) AS cnt FROM document_processing_queue GROUP BY status ORDER BY status"
    ) or []


@st.cache_data(ttl=55)
def _load_alerts(tender_db) -> list[dict]:
    return tender_db.execute_query(
        """
        SELECT alert_type, message, created_at
        FROM daemon_alerts
        WHERE acknowledged = FALSE
        ORDER BY created_at DESC
        LIMIT 10
        """
    ) or []


def render_monitoring_page(service) -> None:
    st.title("📊 Мониторинг сервера 13")

    hours = st.sidebar.slider("История (часов)", 1, 24, 3)
    if st.button("↻ Обновить", use_container_width=True):
        st.cache_data.clear()
        st.rerun()

    tender_db = getattr(service, "tender_db", None)
    if not tender_db:
        st.error("Нет подключения к БД")
        return

    df = _load_metrics(tender_db, hours)

    # ── Текущие значения ──────────────────────────────────────────────────────
    st.subheader("Сейчас")
    if not df.empty:
        last = df.iloc[-1]
        c1, c2, c3, c4, c5 = st.columns(5)
        c1.metric("CPU темп",   _temp_color(int(last.get("cpu_temp") or 0),  _CPU_WARN, _CPU_CRIT))
        c2.metric("GPU темп",   _temp_color(int(last.get("gpu_temp") or 0),  _GPU_WARN, _GPU_CRIT))
        c3.metric("RAM",        f"{last.get('ram_pct') or 0:.0f}%")
        c4.metric("Load 1m",    f"{last.get('load_1min') or 0:.2f}")
        c5.metric("CPU %",      f"{last.get('cpu_pct') or 0}%")
        st.caption(f"Обновлено: {df.index[-1].strftime('%H:%M:%S')}")
    else:
        st.info("Данных пока нет — скрипт мониторинга пишет раз в минуту")

    # ── Графики температуры ───────────────────────────────────────────────────
    if not df.empty:
        st.subheader("Температура")
        temp_df = df[["cpu_temp", "gpu_temp"]].rename(
            columns={"cpu_temp": "CPU °C", "gpu_temp": "GPU °C"}
        )
        st.line_chart(temp_df, height=220, use_container_width=True)

        # Красная линия предупреждения 75°C как горизонтальная метка
        max_cpu = int(df["cpu_temp"].max() or 0)
        if max_cpu >= _CPU_WARN:
            st.caption(f"⚠️ Максимум CPU за период: {max_cpu}°C")

        st.subheader("Нагрузка и RAM")
        load_df = df[["load_1min", "load_5min", "ram_pct"]].rename(
            columns={"load_1min": "Load 1m", "load_5min": "Load 5m", "ram_pct": "RAM %"}
        )
        st.line_chart(load_df, height=200, use_container_width=True)

    # ── Демоны ───────────────────────────────────────────────────────────────
    st.subheader("Демоны обработки документов")
    import subprocess

    rows_d = []
    for svc, wid, desc in _WORKERS:
        try:
            r = subprocess.run(
                ["ssh", "-i", r"C:\Users\Lenovo\.ssh\id_ed25519_codex_worker",
                 "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 "sergey@10.0.0.13",
                 f"systemctl is-active {svc}"],
                capture_output=True, text=True, timeout=8
            )
            status = r.stdout.strip() or "unknown"
        except Exception:
            status = "unreachable"
        icon = "🟢" if status == "active" else "🔴"
        rows_d.append({"Сервис": svc, "worker_id": wid, "Источник": desc, "Статус": f"{icon} {status}"})
    st.dataframe(pd.DataFrame(rows_d), use_container_width=True, hide_index=True)

    # ── Очередь ──────────────────────────────────────────────────────────────
    st.subheader("Очередь документов")
    queue_rows = _load_queue(tender_db)
    if queue_rows:
        q_df = pd.DataFrame(queue_rows).rename(columns={"cnt": "Кол-во", "status": "Статус"})
        cols = st.columns(len(queue_rows))
        for col, row in zip(cols, queue_rows):
            col.metric(str(row["status"]), int(row["cnt"]))
    else:
        st.info("Очередь не читается")

    # ── Алерты ───────────────────────────────────────────────────────────────
    alerts = _load_alerts(tender_db)
    if alerts:
        st.subheader("⚠️ Активные алерты")
        for a in alerts:
            st.warning(f"[{a.get('alert_type')}] {a.get('message')} — {a.get('created_at')}")
