# Factual copy of S13 /etc/systemd/system/tendermonitor-eis-parser-backward.service
# Host: S13. Service user: tendermonitor.
# Observed 2026-08-17: enabled/active. EIS HTTP goes via eis-s7-gateway-forward.
# Unit TENDERMONITOR_STOP_BEFORE=2021-01-01 overrides backward/config.ini runtime.stop_before_date.

[Unit]
Description=TenderMonitor - EIS parser BACKWARD catchup on S13 (EIS via S7 gateway)
After=network-online.target eis-s7-gateway-forward.service
Requires=eis-s7-gateway-forward.service
Wants=network-online.target

[Service]
Type=simple
User=tendermonitor
WorkingDirectory=/opt/tendermonitor
Environment=PATH=/opt/tendermonitor/venv/bin
Environment=TENDERMONITOR_CONFIG=/opt/tendermonitor/backward/config.ini
Environment=TENDERMONITOR_PROCESSED_DATES=/opt/tendermonitor/backward/processed_dates.json
Environment=TENDERMONITOR_REGION_PROGRESS=/opt/tendermonitor/backward/region_progress.json
Environment=TENDERMONITOR_LOG_DIR=/opt/tendermonitor/backward
Environment=TENDERMONITOR_DIRECTION=backward
Environment=TENDERMONITOR_STOP_BEFORE=2021-01-01
ExecStart=/opt/tendermonitor/venv/bin/python /opt/tendermonitor/main.py
Restart=on-failure
RestartSec=30
Nice=15
CPUWeight=50
IOWeight=50
MemoryMax=4G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tendermonitor-backward-s13

[Install]
WantedBy=multi-user.target
